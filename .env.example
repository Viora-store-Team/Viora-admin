# ملف محلي — مش متتبّع بـ git (.gitignore فيه .env*)

# ─── مصدر البيانات ───────────────────────────────────────────────
# الافتراضي `true` — اللوحة بتشتغل على بيانات تجريبية بالذاكرة
# (src/lib/admin/mock/) وبيظهر شريط تنبيه فوق كل صفحة.
#
# لما توصل مسارات /api/admin/* من الباك إند: حطّ `false`، جرّب،
# وبعدها احذف مجلد mock/ وبسّط src/lib/admin/client.ts.
#
# ⚠️ بعد ما تعدّله لازم **تعيد تشغيل سيرفر التطوير** — Next بيحقن
# متغيّرات NEXT_PUBLIC_* وقت البناء مش وقت التشغيل.
# NEXT_PUBLIC_ADMIN_MOCK=false

# ─── الباك إند ───────────────────────────────────────────────────
# الافتراضي هو السيرفر المنشور. فكّ التعليق بس لما تشتغل على باك إند محلي.
# بيتجاهله التطبيق كلياً وهو بوضع الـ mock.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
